rules_version = '2';

// ElonUz Firestore xavfsizlik qoidalari.
// Deploy: `firebase deploy --only firestore:rules`
// Bu qoidalar "test mode" ni almashtiradi — 30 kunlik ochiq rejim tugashidan oldin qo'llang.
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil — faqat egasi o'qiydi/yozadi (`users/{uid}`).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Biznes (`businesses/{businessId}`) — hujjatда ownerId. Hamma o'qiydi, faqat egasi yozadi/o'chiradi.
    match /businesses/{businessId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Chegirma e'lonlari (`listings/{id}`):
    // - har qanday kirgan foydalanuvchi o'qiy oladi (talaba chegirmalarni ko'radi),
    // - faqat egasi (ownerId == uid) yaratadi/o'zgartiradi/o'chiradi.
    match /listings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // Real-time chat (`conversations/{id}` + `messages` subkolleksiyasi).
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
