<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Internet holatini tekshirish (NetworkConnectivity). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Filial/joylashuvni xaritada ko'rsatish uchun (ixtiyoriy). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:name=".ElonUzApp"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ElonUz">

        <!-- Yagona kirish nuqtasi — to'g'ridan-to'g'ri biznes (ElonUz) oqimi. Rol tanlash yo'q. -->
        <activity
            android:name=".ElonUzActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
