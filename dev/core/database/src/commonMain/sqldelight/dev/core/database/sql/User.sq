-- Joriy (kirgan) foydalanuvchi sessiyasining local keshi.
-- Bitta qatordan iborat: offline ishlash va avtomatik kirish uchun.
-- Profil maydonlari (universitet, kurs, rol...) bu yerda EMAS — ular `ProfileEntity`
-- jadvalida, unga `:dev:feature:profile` moduli egalik qiladi (migratsiya v6).
CREATE TABLE UserEntity (
    uid TEXT NOT NULL PRIMARY KEY,
    userId INTEGER NOT NULL,
    fullName TEXT NOT NULL,
    email TEXT NOT NULL,
    role TEXT NOT NULL,
    phoneNumber TEXT,
    photoUrl TEXT
);

selectCurrent:
SELECT * FROM UserEntity LIMIT 1;

upsert:
INSERT OR REPLACE INTO UserEntity(
    uid, userId, fullName, email, role, phoneNumber, photoUrl
) VALUES (?, ?, ?, ?, ?, ?, ?);

clear:
DELETE FROM UserEntity;
